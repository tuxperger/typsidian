<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Доступ к vault в общей памяти устройства.

         Vault обязан переживать удаление приложения и быть виден файловому
         менеджеру и синхронизации (принцип VI) — приватный каталог приложения
         не даёт ни того, ни другого, а SAF отдаёт `content://`-адреса, которых
         `NativeBackend` не понимает: он построен на `std::fs`.

         Две эпохи Android требуют разного. С API 30 работает только
         MANAGE_EXTERNAL_STORAGE, и выдаётся оно не диалогом, а отдельным
         экраном настроек (см. MainActivity). До API 29 включительно его не
         существует, и хватает обычной пары READ/WRITE, запрашиваемой диалогом;
         `maxSdkVersion` не даёт им попасть в список прав на новых системах,
         где они всё равно ничего не значат. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- `requestLegacyExternalStorage` — только для API 29: там общая память
         уже «ограниченная», но старая модель ещё доступна по этому флагу. На
         API 30+ он игнорируется: его место занимает MANAGE_EXTERNAL_STORAGE. -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.typsidian_mobile"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Быстрый захват (фича 022): «Поделиться» текстом, ссылкой и
                 картинкой из любого приложения. Разбирает плагин `capture`
                 (plugins/capture/android), запись попадает в очередь на
                 устройстве и пишется в vault, когда окно её подтвердит. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- Ярлыки приложения «Сегодня» и «Во входящие» (res/xml/shortcuts.xml). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="typsidian" android:host="today" />
                <data android:scheme="typsidian" android:host="capture" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
