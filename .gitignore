# --- Зависимости ---
node_modules/

# --- Rust ---
# Один паттерн покрывает и корневой target/, и apps/desktop/src-tauri/target/.
target/
result
*.rs.bk

# --- wasm-pack ---
# packages/core/pkg — вывод `pnpm build:wasm`; остальные два — его копии,
# которые раскладывают по местам скрипты сборки.
packages/core/pkg/
ui/src/wasm-core/
ui/dist/wasm-core/
# Встроенные шрифты предпросмотра для web — копия из typst-assets (005 T029).
apps/web/public/fonts/typst/
# Словари орфографии для web — копия из packages/core/dictionaries (030).
apps/web/public/dictionaries/

# --- Сборка пакетов ---
# ui/dist собирается из ui/src через `pnpm --filter @typsidian/ui build`,
# apps/desktop/dist и apps/mobile/dist — вывод Vite.
ui/dist/
apps/desktop/dist/
apps/mobile/dist/

# --- Next.js ---
.next/
out/

# --- TypeScript ---
*.tsbuildinfo

# --- Tauri ---
# gen/schemas перегенерируется на каждой сборке из capabilities/.
apps/desktop/src-tauri/gen/schemas/
apps/mobile/src-tauri/gen/schemas/

# gen/android, наоборот, коммитится: там лежат правки, которых в шаблоне нет
# (разрешение на общую память в AndroidManifest.xml и MainActivity.kt). Своим
# .gitignore проект Gradle сам отсекает всё пересобираемое.

# Android-часть плагина быстрого захвата (022): вывод Gradle и копия tauri-api,
# которую Tauri раскладывает при сборке плагина.
apps/mobile/src-tauri/plugins/capture/android/build/
apps/mobile/src-tauri/plugins/capture/android/.tauri/

# --- Локальное состояние ---
.claude/settings.local.json
.env
.env.local
.env.*.local
# Каталог данных сервера по умолчанию (037): база аккаунтов, их vault и секреты
# синхронизации — данные пользователей, а не исходники.
/typsidian-data/

# --- Логи ---
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# --- ОС и редакторы ---
.DS_Store
Thumbs.db
*.swp
*~

# Выгрузка в Claude Design (/design-sync): сборка и рабочие файлы
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Выгрузки макетов из Claude Design (zip с артбордами): разобранные артборды
# фичи лежат в её каталоге — `specs/NNN-*/design/`.
new_design/
