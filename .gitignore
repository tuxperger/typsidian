# --- Зависимости ---
node_modules/

# --- Rust ---
# Один паттерн покрывает и корневой target/, и apps/desktop/src-tauri/target/.
target/
result
*.rs.bk

# --- wasm-pack ---
# packages/core/pkg — вывод `pnpm build:wasm`; остальные два — его копии,
# которые раскладывают по местам скрипты сборки.
packages/core/pkg/
ui/src/wasm-core/
ui/dist/wasm-core/
# Встроенные шрифты предпросмотра для web — копия из typst-assets (005 T029).
apps/web/public/fonts/typst/

# --- Сборка пакетов ---
# ui/dist собирается из ui/src через `pnpm --filter @typsidian/ui build`,
# apps/desktop/dist и apps/mobile/dist — вывод Vite.
ui/dist/
apps/desktop/dist/
apps/mobile/dist/

# --- Next.js ---
.next/
out/

# --- TypeScript ---
*.tsbuildinfo

# --- Tauri ---
# gen/schemas перегенерируется на каждой сборке из capabilities/.
apps/desktop/src-tauri/gen/schemas/
apps/mobile/src-tauri/gen/schemas/

# gen/android, наоборот, коммитится: там лежат правки, которых в шаблоне нет
# (разрешение на общую память в AndroidManifest.xml и MainActivity.kt). Своим
# .gitignore проект Gradle сам отсекает всё пересобираемое.

# --- Локальное состояние ---
.claude/settings.local.json
.env
.env.local
.env.*.local

# --- Логи ---
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# --- ОС и редакторы ---
.DS_Store
Thumbs.db
*.swp
*~
